    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "astro": "^7.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
