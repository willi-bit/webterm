---
import { education, profile, skillGroups } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" width="medium">
  <div class="about-grid">
    <img
      class="profile-photo"
      src="/images/willi-bittorf.jpg"
      width="300"
      height="300"
      alt="Portrait of Willi Bittorf"
    />
    <div>
      <header class="page-heading">
        <p class="page-eyebrow">whoami</p>
        <h1>About</h1>
        <p class="page-lede">{profile.introduction}</p>
      </header>
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>

  <section aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills</h2>
    <dl class="defs">
      {
        skillGroups.map((group) => (
          <div class="defs__row">
            <dt>{group.title}</dt>
            <dd>{group.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    {
      education.map((item) => (
        <article>
          <p class="period">
            {item.period} · {item.location}
          </p>
          <h3>{item.degree}</h3>
          <p class="muted">{item.institution}</p>
          <p class="muted">
            <strong>Selected coursework:</strong> {item.details.join(", ")}
          </p>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="languages-heading">
    <h2 id="languages-heading">Languages</h2>
    <dl class="defs">
      {
        profile.languages.map((item) => (
          <div class="defs__row">
            <dt>{item.language}</dt>
            <dd>{item.proficiency}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</BaseLayout>
