---
import DocShell from "../components/DocShell.astro";
import { education, experience, profile, skillGroups } from "../data/site";
import { formatPeriod } from "../lib/dates";
import BaseLayout from "../layouts/BaseLayout.astro";

const current = experience.find((item) => !item.end);
const degree = education[0];

const facts: [string, string][] = [
  ["name", profile.name],
  ["role", profile.role],
  ["based", profile.location],
  ...(current ? [["now", `${current.role}, ${current.company}`] as [string, string]] : []),
  ...(degree ? [["studied", `B.Sc. Computer Science, ${degree.institution}`] as [string, string]] : []),
];
---

<BaseLayout title="About">
  <DocShell
    file="about.md"
    command="cat about.md"
    outline={[
      { id: "about", label: "# about" },
      { id: "skills", label: "## skills" },
      { id: "education", label: "## education" },
      { id: "languages", label: "## languages" },
    ]}
  >
    <header class:list={["about-head", { "about-head--no-photo": !profile.photo }]} id="about">
      {
        profile.photo && (
          <figure class="portrait">
            <img src={profile.photo} width="300" height="300" alt={`Portrait of ${profile.name}`} />
          </figure>
        )
      }
      <div class="about-head__text">
        <h1 class="doc-title">About</h1>
        <dl class="fetch">
          {
            facts.map(([key, value]) => (
              <div>
                <dt>{key}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <p class="lede">{profile.introduction}</p>
    {profile.about.map((paragraph) => <p>{paragraph}</p>)}

    <h2 id="skills">Skills</h2>
    <dl class="leaders">
      {
        skillGroups.map((group) => (
          <div>
            <dt>{group.title}</dt>
            <dd>
              <ul class="tags">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>

    <h2 id="education">Education</h2>
    {
      education.map((item) => (
        <article class="entry">
          <p class="entry__meta">
            <span class="entry__period">{formatPeriod(item.start, item.end)}</span>
            <span>{item.location}</span>
          </p>
          <h3 class="entry__title">{item.degree}</h3>
          <p class="entry__org">
            {item.institution}
            {item.grade && <span> · final grade {item.grade}</span>}
          </p>
          <p class="entry__label">Selected coursework</p>
          <ul class="tags">
            {item.details.map((detail) => (
              <li>{detail}</li>
            ))}
          </ul>
        </article>
      ))
    }

    <h2 id="languages">Languages</h2>
    <dl class="leaders">
      {
        profile.languages.map((item) => (
          <div>
            <dt>{item.language}</dt>
            <dd>{item.proficiency}</dd>
          </div>
        ))
      }
    </dl>

    <p class="doc__next">
      <a href="/experience/">next: experience →</a>
    </p>
  </DocShell>
</BaseLayout>
