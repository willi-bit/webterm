---
import { projects } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects" width="medium">
  <header class="page-heading">
    <p class="page-eyebrow">ls projects/</p>
    <h1>Projects</h1>
    <p class="page-lede">Selected work with context, decisions, and results.</p>
  </header>

  <ol class="index">
    {
      projects.map((project) => (
        <li class="index__row">
          <div>
            <h2 class="index__title">
              <a href={`/projects/${project.slug}/`}>{project.title}</a>
            </h2>
            <p class="index__summary">{project.summary}</p>
            <p class="index__meta">{project.technologies.join(" · ")}</p>
          </div>
        </li>
      ))
    }
  </ol>
</BaseLayout>
