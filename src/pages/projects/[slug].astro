---
import type { GetStaticPaths } from "astro";
import { projects, type Project } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() =>
  projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={project.title} description={project.summary} width="narrow">
  <article>
    <header class="page-heading">
      <p class="page-eyebrow">cat projects/{project.slug}/README.md</p>
      <h1>{project.title}</h1>
      <p class="page-lede">{project.summary}</p>
    </header>

    <p>{project.description}</p>

    <dl class="defs defs--spaced">
      <div class="defs__row">
        <dt>Technologies</dt>
        <dd>{project.technologies.join(", ")}</dd>
      </div>
      {
        project.links.length > 0 && (
          <div class="defs__row">
            <dt>Links</dt>
            <dd>
              {project.links.map((link, index) => (
                <>
                  <a href={link.href}>{link.label} ↗</a>
                  {index < project.links.length - 1 && " · "}
                </>
              ))}
            </dd>
          </div>
        )
      }
    </dl>

    <p class="muted"><a href="/projects/">← All projects</a></p>
  </article>
</BaseLayout>
