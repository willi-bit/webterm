---
import Terminal from "../components/Terminal";
import { profile } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="hero">
    <h1>
      {profile.name}
      <span class="hero__role">{" — "}{profile.role}</span>
    </h1>
  </section>

  <Terminal client:load />

  <noscript>
    <p>
      The interactive terminal requires JavaScript. The complete portfolio remains
      available from the navigation above.
    </p>
  </noscript>
</BaseLayout>
