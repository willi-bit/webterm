---
import {
  education,
  experience,
  profile,
  skillGroups,
} from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV">
  <header class="page-heading">
    <p>open cv.pdf</p>
    <h1>{profile.name}</h1>
    <p>{profile.role} · {profile.location}</p>
    <p>
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <p class="page-actions">
      <a class="button-link" href="/cv.pdf" download>Download English CV (PDF)</a>
      <a class="button-link button-link--secondary" href="/cv.pdf">Open PDF</a>
    </p>
  </header>

  <section aria-labelledby="cv-profile-heading">
    <h2 id="cv-profile-heading">Profile</h2>
    <p>{profile.introduction}</p>
  </section>

  <section aria-labelledby="cv-education-heading">
    <h2 id="cv-education-heading">Education</h2>
    {
      education.map((item) => (
        <article>
          <h3>{item.degree} — {item.institution}</h3>
          <p>{item.period} · {item.location}</p>
          <p><strong>Selected coursework:</strong> {item.details.join(", ")}</p>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="cv-experience-heading">
    <h2 id="cv-experience-heading">Experience</h2>
    {
      experience.map((item) => (
        <article>
          <h3>{item.role} — {item.company}</h3>
          <p>{item.period}</p>
          <p>{item.summary}</p>
          <ul>
            {item.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="cv-skills-heading">
    <h2 id="cv-skills-heading">Skills</h2>
    {
      skillGroups.map((group) => (
        <p><strong>{group.title}:</strong> {group.items.join(", ")}</p>
      ))
    }
  </section>

  <section aria-labelledby="cv-languages-heading">
    <h2 id="cv-languages-heading">Languages</h2>
    <p>
      {profile.languages.map((item) => `${item.language}: ${item.proficiency}`).join(" · ")}
    </p>
  </section>
</BaseLayout>
