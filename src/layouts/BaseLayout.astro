---
import { navigation, profile } from "../data/site";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = profile.introduction,
} = Astro.props;

const documentTitle = title ? `${title} | ${profile.name}` : `${profile.name} | ${profile.role}`;
const currentPath = Astro.url.pathname;
const isCurrentRoute = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a12" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
      <a class="site-identity" href="/">
        <img src="/icons/favicon-32.png" width="32" height="32" alt="" />
        <span>{profile.name}</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul class="site-navigation">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrentRoute(item.href) ? "page" : undefined}
                  {...("command" in item ? { "data-command": item.command } : {})}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main-content" class="site-main">
      <slot />
    </main>


    <script is:inline>
      // When the terminal is on the page, navigation links with a matching
      // command stop being routes: they run the command in the terminal and
      // let it scroll itself into view. Everywhere else the links keep their
      // normal behaviour, so the site still works without JavaScript.
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) {
          return;
        }
        const link = event.target.closest("a[data-command]");
        if (!link || !document.querySelector("[data-terminal]")) {
          return;
        }
        event.preventDefault();
        window.dispatchEvent(
          new CustomEvent("webterm:run", { detail: link.dataset.command }),
        );
      });
    </script>
  </body>
</html>
